# Copy this file to backend/.env and fill in the values.
# Never commit backend/.env. Stripe will send these through a secure channel.

# Secret key from the Stripe dashboard (starts with sk_test_ or sk_live_).
STRIPE_SECRET_KEY=

# Signing secret for the webhook endpoint (starts with whsec_).
STRIPE_WEBHOOK_SECRET=

# Used only to sign login cookies. Use a long random string.
JWT_SECRET=

# Backend port used locally.
PORT=8080

# Public address of this site. Stripe redirects the customer back here.
APP_BASE_URL=http://127.0.0.1:8080

# Stripe local webhook URL to register in the Stripe dashboard:
# http://127.0.0.1:8080/api/payments/webhook
