<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Booking Confirmed | J Transport Group LTD</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="assets/css/style.css" rel="stylesheet">
</head>
<body>
<header class="site-header"><div class="nav-shell">
  <a class="brand" href="index.html"><img class="brand-logo" src="assets/images/mlt/logo.png" alt="J Transport Group LTD"></a>
  <a class="header-phone" href="tel:+442039962897">+44 20 3996 2897</a>
</div></header>
<main>
  <section class="booking-section standalone-booking">
    <div class="booking-card">
      <span class="section-kicker">J TRANSPORT GROUP LTD</span>
      <h2 id="pay-title">Booking Confirmation</h2>
      <div id="pay-body" class="trip-summary"></div>
      <a class="search-button" href="index.html">Book Another Transfer</a>
    
      <div class="review-success-box" style="margin-top:24px;padding:22px;background:#fffdf5;border:1.5px solid #ebd46d;border-radius:12px;text-align:center;">
        <h3 style="font-size:19px;font-weight:700;margin-bottom:6px;color:#1a1a18;">Thank you for choosing J Transport.</h3>
        <p style="font-size:13.5px;color:#555;margin-bottom:16px;">Happy with our service? We'd love to hear from you.</p>
        <div style="display:flex;flex-direction:column;align-items:center;gap:10px;width:100%;max-width:320px;margin:0 auto;">
          <a href="https://g.page/r/CeiPQzjIIFDsECE/review" target="_blank" rel="noopener noreferrer" class="yellow-pill" style="font-size:13px;padding:11px 22px;font-weight:600;display:inline-flex;align-items:center;justify-content:center;gap:8px;width:100%;">⭐ Leave a Google Review <i class="bi bi-box-arrow-up-right"></i></a>
          <a href="https://www.facebook.com/share/1FKnQNM6Cb/" target="_blank" rel="noopener noreferrer" class="yellow-pill" style="font-size:13px;padding:11px 22px;font-weight:600;display:inline-flex;align-items:center;justify-content:center;gap:8px;width:100%;background:#1877f2;color:#ffffff;border-color:#1877f2;"><i class="bi bi-facebook" style="font-size:15px;"></i> ⭐ Leave us a Facebook Review <i class="bi bi-box-arrow-up-right"></i></a>
          <a href="https://www.instagram.com/jtransportgroupltd?utm_source=qr&stkn=MW9oOGcxOXc4bnJlbA==" target="_blank" rel="noopener noreferrer" class="yellow-pill" style="font-size:13px;padding:11px 22px;font-weight:600;display:inline-flex;align-items:center;justify-content:center;gap:8px;width:100%;background:linear-gradient(45deg,#f09433,#e6683c,#dc2743,#cc2366,#bc1888);color:#ffffff;border-color:transparent;"><i class="bi bi-instagram" style="font-size:15px;"></i> 📸 Follow us on Instagram <i class="bi bi-box-arrow-up-right"></i></a>
        </div>
      </div>

    </div>
  </section>
</main>
<script src="assets/js/script.js"></script>
<script src="assets/js/api.js"></script>
<script>
  const params = new URLSearchParams(location.search);
  const sessionId = params.get('session_id');
  const bookingRef = params.get('booking');
  const method = params.get('method');
  const title = document.querySelector('#pay-title');
  const body = document.querySelector('#pay-body');

  const pounds = pence => '£' + (Number(pence || 0) / 100).toFixed(2);

  if (bookingRef && method === 'cash') {
    title.textContent = 'Booking Confirmed (Pay Cash in Car)';
    api('/api/bookings/' + encodeURIComponent(bookingRef)).then(trip => {
      body.replaceChildren();
      const line1 = document.createElement('p');
      line1.style.fontWeight = 'bold';
      line1.style.color = '#28a745';
      line1.textContent = 'Ref: ' + trip.reference + ' · Status: Cash on Arrival';

      const line2 = document.createElement('p');
      line2.textContent = trip.pickup + ' → ' + trip.dropoff + ' (' + trip.vehicle + ')';

      const line3 = document.createElement('p');
      line3.style.fontSize = '18px';
      line3.style.color = '#b08d00';
      line3.style.fontWeight = '700';
      line3.textContent = 'Total Fare: ' + pounds(trip.amountPence) + ' (Pay Cash to Driver)';

      const line4 = document.createElement('p');
      line4.style.fontSize = '14px';
      line4.style.lineHeight = '1.6';
      line4.style.marginTop = '12px';
      line4.style.color = '#28a745';
      line4.style.fontWeight = '600';
      line4.textContent = '✓ Confirmation email has been sent to passenger (' + trip.email + ') and company management.';

      body.append(line1, line2, line3, line4);
    }).catch(() => {
      body.textContent = 'Ref: ' + bookingRef + ' · Please pay cash to your driver upon arrival. Confirmation email sent to passenger and company management.';
    });
  } else if (!sessionId) {
    title.textContent = 'No payment to confirm';
    body.textContent = 'Return to booking and try the payment again.';
  } else {
    api('/api/payments/confirm?session_id=' + encodeURIComponent(sessionId)).then(trip => {
      body.replaceChildren();
      if (trip.status === 'paid') title.textContent = 'Booking Confirmed & Payment Received';
      else if (trip.status === 'processing') title.textContent = 'Payment is Processing';
      else if (trip.status === 'failed') title.textContent = 'Payment Failed';
      else title.textContent = 'Payment Not Completed';

      const line1 = document.createElement('p');
      line1.style.fontWeight = '700';
      line1.textContent = 'Ref: ' + trip.reference + ' · ' + trip.pickup + ' → ' + trip.dropoff + ' · ' + pounds(trip.amountPence);

      const line2 = document.createElement('p');
      line2.style.fontSize = '14px';
      line2.style.lineHeight = '1.6';
      line2.style.marginTop = '12px';

      if (trip.status === 'paid') {
        line2.style.color = '#28a745';
        line2.style.fontWeight = '600';
        line2.textContent = '✓ Confirmation email & payment receipt have been sent to passenger (' + trip.email + ') and company management.';
      }

      body.append(line1, line2);
    }).catch(error => {
      title.textContent = 'We could not confirm the payment';
      body.textContent = error.message;
    });
  }
</script>
</body>
</html>
